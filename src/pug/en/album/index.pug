doctype html
html(lang='en').bg-light

    head

        meta(charset='utf-8')
        meta(name='viewport' content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description' content='Matthew W. Thomas & Maria Fernanda Petri Betto are getting married on July 26, 2025 in São Paulo, Brazil. Join us for the celebration!')
        meta(name='author' content='Matthew W. Thomas and Maria Fernanda Petri Betto')

        title Matthew &amp; Maria Fernanda | Wedding Site

        link(rel='icon' type='image/svg+xml' href='/assets/img/favicon.svg')
        link(rel='icon' type='image/png' href='/assets/img/favicon.png')

        //- Core theme CSS (includes Bootstrap)
        link(href='/css/styles.css?v=' + new Date().getTime(), rel='stylesheet')

    body.bg-white.bg-cream-paper.constrained

        //- Navigation
        nav#mainNav.navbar.navbar-expand-lg.shadow-sm
            .container.px-4.px-lg-5
                a.navbar-brand(href='/en/')
                    img(src='/assets/img/mm.svg' alt='Matthew & Maria Fernanda' height='30')
                button#navbarToggle.navbar-toggler.navbar-toggler-right.collapsed(type='button' aria-controls='navbarResponsive' aria-expanded='false' aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto
                        li.nav-item
                            a.nav-link(href='/en/') Home
                        li.nav-item
                            a.nav-link(href='#video') Videos
                        li.nav-item
                            a.nav-link(href='#album') Photos

        //- Video title
        section#video.video-section.bg-primary.bg-paper-fibers.shadow-sm
            .container.p-4.px-lg-5
                .row.gx-4.gx-lg-5.justify-content-center
                    .col-lg-8.text-center.text-white
                        h2.mb-4 Videos
                        p
                            strong The top video is a 45 minute documentary of the entire wedding day from start to finish. There is also a gallery of shorter highlight videos below.

        //- Video players
        section#video-players.video-grid-section.bg-cream-paper.shadow-sm
            .container
                .row.main-video.mb-3
                    .ratio.ratio-16x9.p-1
                        iframe(src="https://player.mediadelivery.net/embed/478999/a47aac33-0ec7-4f8b-b991-f63efb192229?autoplay=false&loop=false&muted=false&preload=false&responsive=true" allowfullscreen)

                .row.video-gallery.mb-3
                    each videoId in ['cdf433e4-6af0-4695-8a14-60ea631b3996', '54ccf4ea-4d46-4b46-b9c8-6083a5e07cb6', '2b0884bb-5d40-4404-8533-4f73b3be870d', 'b4b2d99d-8522-4c4a-acd6-90a755256161', '95af1da0-8a35-46d1-9467-e510c3ad2235', 'c666f123-e1c5-4cad-8329-1a542d04e5a9', '7726645d-5e58-4010-af96-ae06bd20505d', '3ad39180-5c11-4d61-bb9f-ef93d1f99bf6']
                        .col-6.col-lg-3.p-1
                            a(href='https://player.mediadelivery.net/embed/478999/' + videoId + '?autoplay=false&loop=false&muted=false&preload=true&responsive=true')
                                img.foco-thumb.w-100.object-fit-cover.border.border-white.border-4.shadow-sm.rounded(src='https://vz-d9b6b4f2-1f8.b-cdn.net/' + videoId + '/thumbnail.jpg' width='600' alt='' loading='lazy')

        //- Photo title
        section.bg-light.bg-handmade-paper.shadow-sm
            #album.album-section.bg-spattern2
                .container.p-4.px-lg-5
                    .row.gx-4.gx-lg-5.justify-content-center
                        .col-lg-8.py-3.text-center.bg-light.bg-paper-fibers.shadow
                            h2.mb-4 Photo Album
                            p The photo album is not yet complete, but you can see some of the photos below.

        //- Photo grid
        section#photo-grid.photo-grid-section.bg-light.bg-handmade-paper.shadow-sm
            .container
                .row.image-gallery
                    each focoImage in renderFoco()
                        .col-6.col-md-4.col-lg-3.col-xl-2.p-1
                            a(href=focoImage.src data-lightbox=focoImage.lightbox)
                                img.foco-image.w-100.object-fit-cover.border.border-white.border-4.shadow-sm.rounded(src=focoImage.thumb width='600' alt='' loading='lazy')

        //- Theme JS
        script!= renderScripts(["simple-lightbox", "album"])

        //- Footer
        footer.footer.small.bg-secondary.bg-opacity-50.bg-handmade-paper.shadow-sm
            .container.p-4.px-lg-5.signoff
                .row.my-4.justify-content-center.align-items-end
                    .col-12.col-xl-6
                        .d-flex.flex-column.align-items-center.justify-content-end.author-signature
                            img(src='/assets/img/footer/signature-mwt.svg' alt='Matthew W. Thomas' width='300' loading='lazy')
                            hr.m-0.mb-4
                            p.text-uppercase Matthew W. Thomas
                    .col-12.col-xl-6
                        .d-flex.flex-column.align-items-center.justify-content-end.author-signature
                            img(src='/assets/img/footer/signature-mfpb.svg' alt='Maria Fernanda Petri Betto' width='300' loading='lazy')
                            hr.m-0.mb-4
                            p.text-uppercase Maria Fernanda Petri Betto
