doctype html
html(lang='en').h-100.w-100

    head

        meta(charset='utf-8')
        meta(name='viewport' content='width=device-width, initial-scale=1, shrink-to-fit=no')

        title Matthew &amp; Maria Fernanda | 404

        link(rel='icon' type='image/svg+xml' href='/assets/img/favicon.svg')
        link(rel='icon' type='image/png' href='/assets/img/favicon.png')

        //- Core theme CSS (includes Bootstrap)
        link(href='/css/styles.css?v=' + new Date().getTime(), rel='stylesheet')

        //- Open graph meta tags for social media link previews
        meta(property='og:type' content='website')
        meta(property='og:image' content='https://matthewandmaria.com/assets/img/foco/lightbox/156-_ota7658_54700217194_o.jpg')
        meta(property='og:image:width' content='1600')
        meta(property='og:image:height' content='1067')

    body.d-flex.align-items-center.justify-content-center.h-100.w-100.bg-info.bg-paper-fibers
        .container.bg-cream-paper.bg-light.p-4.shadow
            .row.justify-content-center
                .col-6.col-lg-4.d-flex.flex-column.justify-content-center.align-items-center.p-3
                    img.img-fluid.mm-bounce(src='/assets/img/bird1.png' height='612' width='718' alt='Decorative image of a bird perched on a branch' loading='lazy')
                .col-12.col-md-6.col-lg-8.d-flex.flex-column.justify-content-center.align-items-center.p-3
                    h1 404
                    p The page you are looking for could not be found.
                    p A página que você estava tentando acessar não existe neste endereço.
                    ul 
                        li
                            strong Home: 
                            a(href='/en/') english
                            |  
                            a(href='/pt/') português
                        li
                            strong Album: 
                            a(href='/en/album/') english
                            |  
                            a(href='/pt/album/') português
